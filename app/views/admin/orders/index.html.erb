<div class="max-w-6xl mx-auto space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-zinc-200 pb-4 gap-2">
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Диспетчер виробництва</span>
      <h1 class="text-2xl sm:text-3xl font-black text-zinc-900 uppercase tracking-tight">Реєстр замовлень</h1>
    </div>
    <div class="flex gap-2">
      <%= link_to "Усі", admin_orders_path, class: "text-xs font-bold uppercase tracking-wider px-3 py-1.5 border border-zinc-300 #{params[:status].blank? ? 'bg-zinc-900 text-white border-zinc-900' : 'bg-white text-zinc-700 hover:bg-zinc-100'}" %>
      <% Order.statuses.keys.each do |st| %>
        <%= link_to st.upcase, admin_orders_path(status: st), class: "text-xs font-mono-num font-bold uppercase px-3 py-1.5 border border-zinc-300 #{params[:status] == st ? 'bg-zinc-900 text-white border-zinc-900' : 'bg-white text-zinc-700 hover:bg-zinc-100'}" %>
      <% end %>
    </div>
  </div>

  <% if @orders.any? %>
    <div class="bg-white border-2 border-zinc-200 overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-zinc-100 border-b border-zinc-200 text-zinc-600 font-bold uppercase tracking-wider font-mono-num">
          <tr>
            <th class="p-3">№</th>
            <th class="p-3">Дата</th>
            <th class="p-3">Клієнт</th>
            <th class="p-3">Позицій</th>
            <th class="p-3 text-right">Сума</th>
            <th class="p-3 text-center">Статус</th>
            <th class="p-3 text-right">Дія</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-200 font-mono-num">
          <% @orders.each do |order| %>
            <tr class="hover:bg-zinc-50 transition">
              <td class="p-3 font-bold text-zinc-900">#<%= order.id.to_s.rjust(6, '0') %></td>
              <td class="p-3 text-zinc-500"><%= order.created_at.strftime("%d.%m.%Y %H:%M") %></td>
              <td class="p-3 font-sans font-medium text-zinc-900">
                <%= order.full_name %>
                <span class="block text-[11px] text-zinc-400 font-mono-num"><%= order.email %></span>
              </td>
              <td class="p-3 text-zinc-600"><%= order.order_items.sum(:quantity) %> од.</td>
              <td class="p-3 text-right font-black text-zinc-900"><%= number_to_currency(order.total_price, unit: "грн", format: "%n %u") %></td>
<td class="p-3 text-center">
                <span class="inline-block px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider
                  <%= case order.status
                      when 'pending' then 'bg-amber-100 text-amber-900 border border-amber-300'
                      when 'processing' then 'bg-blue-100 text-blue-900 border border-blue-300'
                      when 'shipped' then 'bg-purple-100 text-purple-900 border border-purple-300'
                      when 'completed' then 'bg-emerald-100 text-emerald-900 border border-emerald-300'
                      when 'cancelled' then 'bg-rose-100 text-rose-900 border border-rose-300'
                      end %>">
                  <%= order.human_status %>
                </span>
              </td>
              <td class="p-3 text-right">
                <%= link_to "Деталі", admin_order_path(order), class: "inline-block border border-zinc-900 px-3 py-1 font-sans font-bold uppercase text-[10px] hover:bg-zinc-900 hover:text-white transition" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white border-2 border-zinc-200 p-8 text-center text-zinc-500 text-sm">
      Замовлень за вказаним фільтром не зареєстровано.
    </div>
  <% end %>
</div>