<div class="max-w-md mx-auto mt-10 bg-white p-8 border border-gray-200 rounded-xl shadow-sm">
  <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Реєстрація</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :first_name, "Ім'я", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :first_name, autofocus: true, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :last_name, "Прізвище", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :last_name, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div>
      <%= f.label :email, "Електронна пошта", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autocomplete: "email", required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-gray-500 mt-1">Мінімум <%= @minimum_password_length %> символів</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Підтвердження пароля", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= f.submit "Зареєструватися", class: "w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow transition duration-150 cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-4 text-center text-sm text-gray-600">
    Вже маєте акаунт? <%= link_to "Увійти", new_session_path(resource_name), class: "text-blue-600 hover:underline font-medium" %>
  </div>
</div>