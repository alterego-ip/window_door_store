<div class="max-w-lg mx-auto mt-8">
  <div class="bg-white border-2 border-zinc-200 p-8 shadow-xs">
    <div class="border-b border-zinc-200 pb-4 mb-6">
      <span class="text-[10px] font-bold uppercase tracking-widest text-amber-600 block">Новий користувач</span>
      <h2 class="text-xl font-black uppercase tracking-tight text-zinc-900">Реєстрація профілю</h2>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, "Ім'я", class: "block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1" %>
          <%= f.text_field :first_name, autofocus: true, required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-sm text-zinc-900 focus:outline-none transition" %>
        </div>

        <div>
          <%= f.label :last_name, "Прізвище", class: "block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1" %>
          <%= f.text_field :last_name, required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-sm text-zinc-900 focus:outline-none transition" %>
        </div>
      </div>

      <div>
        <%= f.label :email, "Робочий Email", class: "block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email", required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-sm text-zinc-900 focus:outline-none transition" %>
      </div>

      <div>
        <%= f.label :password, "Пароль (мін. 6 символів)", class: "block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password", required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-sm text-zinc-900 focus:outline-none transition" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Підтвердження пароля", class: "block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-sm text-zinc-900 focus:outline-none transition" %>
      </div>

      <div class="pt-3">
        <%= f.submit "Підтвердити реєстрацію", class: "w-full bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-bold uppercase tracking-widest py-3 transition cursor-pointer text-center" %>
      </div>
    <% end %>

    <div class="mt-6 pt-4 border-t border-zinc-100 flex items-center justify-between text-xs">
      <span class="text-zinc-500">Вже зареєстровані?</span>
      <%= link_to "Увійти в кабінет", new_session_path(resource_name), class: "font-bold text-amber-700 hover:text-amber-800 hover:underline" %>
    </div>
  </div>
</div>