<div class="max-w-md mx-auto mt-8">
  <div class="bg-white border-2 border-zinc-200 p-8 shadow-xs">
    <div class="border-b border-zinc-200 pb-4 mb-6">
      <span class="text-[10px] font-bold uppercase tracking-widest text-amber-600 block">Особистий кабінет</span>
      <h2 class="text-xl font-black uppercase tracking-tight text-zinc-900">Вхід у систему</h2>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, "Електронна пошта", class: "block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3.5 py-2 text-sm text-zinc-900 focus:outline-none transition font-medium" %>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <%= f.label :password, "Пароль", class: "block text-xs font-bold uppercase tracking-wider text-zinc-700" %>
        </div>
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3.5 py-2 text-sm text-zinc-900 focus:outline-none transition font-medium" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center pt-1">
          <%= f.check_box :remember_me, class: "w-4 h-4 text-zinc-900 border-zinc-300 rounded-none focus:ring-0 cursor-pointer" %>
          <%= f.label :remember_me, "Запам'ятати мене на цьому пристрої", class: "ml-2 block text-xs text-zinc-600 cursor-pointer font-medium" %>
        </div>
      <% end %>

      <div class="pt-2">
        <%= f.submit "Авторизуватися", class: "w-full bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-bold uppercase tracking-widest py-3 transition cursor-pointer text-center" %>
      </div>
    <% end %>

    <div class="mt-6 pt-4 border-t border-zinc-100 flex items-center justify-between text-xs">
      <span class="text-zinc-500">Немає облікового запису?</span>
      <%= link_to "Створити профіль", new_registration_path(resource_name), class: "font-bold text-amber-700 hover:text-amber-800 hover:underline" %>
    </div>
  </div>
</div>