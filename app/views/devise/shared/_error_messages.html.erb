<% if resource.errors.any? %>
  <div class="p-4 bg-rose-50 border-l-4 border-rose-600 text-rose-900 text-xs mb-4">
    <p class="font-bold uppercase tracking-wider mb-2">Зверніть увагу на наступні поля:</p>
    <ul class="list-disc list-inside space-y-1">
      <% resource.errors.each do |error| %>
        <li>
          <strong><%= resource.class.human_attribute_name(error.attribute) %></strong>: <%= error.message %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>