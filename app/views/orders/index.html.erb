<div class="max-w-5xl mx-auto space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-zinc-200 pb-4 gap-2">
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Особистий кабінет клієнта</span>
      <h1 class="text-2xl sm:text-3xl font-black text-zinc-900 uppercase tracking-tight">Історія моїх замовлень</h1>
    </div>
    <div class="text-xs font-mono-num text-zinc-500">
      Усього замовлень: <%= @orders.count %>
    </div>
  </div>

  <% if @orders.any? %>
    <div class="bg-white border-2 border-zinc-200 overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-zinc-100 border-b border-zinc-200 text-zinc-600 font-bold uppercase font-mono-num">
          <tr>
            <th class="p-3.5">Номер</th>
            <th class="p-3.5">Дата оформлення</th>
            <th class="p-3.5">Виробів у замовленні</th>
            <th class="p-3.5 text-right">Сума з ПДВ</th>
            <th class="p-3.5 text-center">Статус виробництва</th>
            <th class="p-3.5 text-right">Документ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-200 font-mono-num">
          <% @orders.each do |order| %>
            <tr class="hover:bg-zinc-50 transition">
              <td class="p-3.5 font-bold text-zinc-900">#<%= order.id.to_s.rjust(6, '0') %></td>
              <td class="p-3.5 text-zinc-600"><%= order.created_at.strftime("%d.%m.%Y %H:%M") %></td>
              <td class="p-3.5 text-zinc-700">
                <%= order.order_items.sum(:quantity) %> од.
              </td>
              <td class="p-3.5 text-right font-black text-zinc-900">
                <%= number_to_currency(order.total_price, unit: "грн", format: "%n %u") %>
              </td>
<td class="p-3.5 text-center">
                <span class="inline-block px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider
                  <%= case order.status
                      when 'pending' then 'bg-amber-100 text-amber-900 border border-amber-300'
                      when 'processing' then 'bg-blue-100 text-blue-900 border border-blue-300'
                      when 'shipped' then 'bg-purple-100 text-purple-900 border border-purple-300'
                      when 'completed' then 'bg-emerald-100 text-emerald-900 border border-emerald-300'
                      when 'cancelled' then 'bg-rose-100 text-rose-900 border border-rose-300'
                      end %>">
                  <%= order.human_status %>
                </span>
              </td>
              <td class="p-3.5 text-right">
                <%= link_to "Специфікація", order_path(order), class: "inline-block border border-zinc-900 px-3 py-1 font-sans font-bold uppercase text-[10px] hover:bg-zinc-900 hover:text-white transition" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white border-2 border-zinc-200 p-12 text-center space-y-4">
      <p class="text-sm font-bold uppercase tracking-wider text-zinc-500">Ви ще не оформили жодного замовлення</p>
      <div class="flex justify-center gap-3">
        <%= link_to "Перейти до каталогу", products_path, class: "bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-bold uppercase tracking-wider px-4 py-2.5 transition" %>
        <%= link_to "Розрахувати вікно", configurator_path, class: "border-2 border-zinc-900 text-zinc-900 hover:bg-zinc-900 hover:text-white text-xs font-bold uppercase tracking-wider px-4 py-2 transition" %>
      </div>
    </div>
  <% end %>
</div>