<div class="max-w-5xl mx-auto space-y-6">
  <div class="border-b border-zinc-200 pb-4">
    <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-amber-600">Фінал оформлення</span>
    <h1 class="text-xl sm:text-3xl font-black text-zinc-900 uppercase tracking-tight">Оформлення замовлення</h1>
  </div>

  <%= form_with model: @order, url: orders_path, method: :post, class: "grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 items-start" do |f| %>
    <div class="lg:col-span-2 space-y-4 sm:space-y-6">
      <div class="bg-white border-2 border-zinc-200 p-4 sm:p-6 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-900 pb-2 border-b border-zinc-100">
          Контактні дані
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :full_name, "ПІБ", class: "block text-[11px] font-bold uppercase text-zinc-700 mb-1" %>
            <%= f.text_field :full_name, required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-xs focus:outline-none" %>
          </div>

          <div>
            <%= f.label :email, "Email", class: "block text-[11px] font-bold uppercase text-zinc-700 mb-1" %>
            <%= f.email_field :email, required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-xs focus:outline-none" %>
          </div>
        </div>
      </div>

      <div class="bg-white border-2 border-zinc-200 p-4 sm:p-6 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-900 pb-2 border-b border-zinc-100">
          Доставка та розрахунок
        </h2>

        <div>
          <%= f.label :delivery_address, "Адреса доставки / монтажу", class: "block text-[11px] font-bold uppercase text-zinc-700 mb-1" %>
          <%= f.text_field :delivery_address, placeholder: "м. Івано-Франківськ...", required: true, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-xs focus:outline-none" %>
        </div>

        <div>
          <%= f.label :payment_method, "Форма оплати", class: "block text-[11px] font-bold uppercase text-zinc-700 mb-1" %>
          <%= f.select :payment_method, options_for_select(Order::PAYMENT_METHODS), {}, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-xs bg-white focus:outline-none" %>
        </div>

        <div>
          <%= f.label :notes, "Примітки до замовлення", class: "block text-[11px] font-bold uppercase text-zinc-700 mb-1" %>
          <%= f.text_area :notes, rows: 2, class: "w-full border-2 border-zinc-200 focus:border-zinc-900 px-3 py-2 text-xs focus:outline-none" %>
        </div>
      </div>
    </div>

    <!-- Резюме замовлення -->
    <div class="bg-zinc-900 text-white p-5 sm:p-6 border-t-4 border-amber-500 shadow-lg lg:sticky lg:top-24">
      <span class="text-[10px] uppercase font-bold tracking-widest text-zinc-400 block mb-1">Специфікація</span>
      <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-200 pb-3 border-b border-zinc-800 mb-4">До сплати</h3>

      <div class="space-y-2 text-xs mb-6 max-h-48 overflow-y-auto">
        <% @cart.cart_items.each do |item| %>
          <div class="flex justify-between py-1 border-b border-zinc-800/80">
            <span class="text-zinc-400 truncate pr-2"><%= item.item_title %> × <%= item.quantity %></span>
            <span class="font-mono-num text-zinc-200 font-bold shrink-0"><%= number_to_currency(item.total_price, unit: "грн", format: "%n %u") %></span>
          </div>
        <% end %>
      </div>

      <div class="mb-6">
        <span class="text-[11px] uppercase tracking-widest text-amber-400 font-bold block mb-1">Загальна сума:</span>
        <div class="text-2xl sm:text-3xl font-black font-mono-num text-white">
          <%= number_to_currency(@cart.total_price, unit: "грн", format: "%n %u") %>
        </div>
      </div>

      <%= f.submit "Підтвердити замовлення", class: "w-full bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold uppercase tracking-widest py-3.5 transition cursor-pointer text-center block" %>
    </div>
  <% end %>
</div>