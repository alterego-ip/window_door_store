<div class="max-w-4xl mx-auto space-y-6">
  <div class="bg-white border-2 border-zinc-200 p-6 sm:p-8">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center border-b border-zinc-200 pb-6 gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full inline-block"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-700">Замовлення зареєстровано</span>
        </div>
        <h1 class="text-2xl font-black uppercase tracking-tight text-zinc-900 font-mono-num">
          Специфікація №<%= @order.id.to_s.rjust(6, '0') %>
        </h1>
        <span class="text-xs text-zinc-400 font-mono-num"><%= @order.created_at.strftime("%d.%m.%Y о %H:%M") %></span>
      </div>

      <div class="text-right">
        <span class="text-[10px] uppercase font-bold tracking-widest text-zinc-400 block">Статус виконання</span>
        <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider bg-zinc-900 text-amber-400 font-mono-num mt-1">
          <%= @order.status.upcase %>
        </span>
      </div>
    </div>

    <!-- Деталі замовника -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 py-6 border-b border-zinc-100 text-xs">
      <div>
        <span class="text-zinc-400 uppercase tracking-wider block mb-1 font-bold">Отримувач:</span>
        <span class="text-zinc-800 font-bold"><%= @order.full_name %></span>
        <span class="text-zinc-500 block"><%= @order.email %></span>
      </div>
      <div>
        <span class="text-zinc-400 uppercase tracking-wider block mb-1 font-bold">Адреса об'єкта / доставки:</span>
        <span class="text-zinc-800 font-bold"><%= @order.delivery_address %></span>
        <span class="text-zinc-500 block font-mono-num">Спосіб розрахунку: <%= @order.payment_method %></span>
      </div>
    </div>

    <!-- Таблиця позицій -->
    <div class="pt-6">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-900 mb-4">Перелік узгоджених виробів</h2>
      <div class="border-2 border-zinc-200 overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-100 border-b border-zinc-200 text-zinc-600 font-bold uppercase tracking-wider">
            <tr>
              <th class="p-3">Найменування позиції</th>
              <th class="p-3 text-center">К-сть</th>
              <th class="p-3 text-right">Ціна за од.</th>
              <th class="p-3 text-right">Сума</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200 font-mono-num">
            <% @order.order_items.each do |item| %>
              <tr>
                <td class="p-3 font-sans font-medium text-zinc-900">
                  <%= item.item_title %>
                  <% if item.custom_configuration %>
                    <span class="block text-[11px] text-zinc-500 font-mono-num mt-0.5">
                      Профіль: <%= item.custom_configuration.profile_system.upcase %>, Скло: <%= item.custom_configuration.glass_type %>
                    </span>
                  <% end %>
                </td>
                <td class="p-3 text-center font-bold"><%= item.quantity %></td>
                <td class="p-3 text-right"><%= number_to_currency(item.unit_price, unit: "грн", format: "%n %u") %></td>
                <td class="p-3 text-right font-black text-zinc-900"><%= number_to_currency(item.total_price, unit: "грн", format: "%n %u") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Підсумок -->
    <div class="flex justify-end pt-6">
      <div class="text-right">
        <span class="text-xs uppercase font-bold tracking-widest text-zinc-400 block mb-1">Загальна вартість із ПДВ:</span>
        <div class="text-3xl font-black font-mono-num text-zinc-900">
          <%= number_to_currency(@order.total_price, unit: "грн", format: "%n %u") %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex justify-between items-center text-xs">
    <%= link_to "← Повернутися до каталогу", products_path, class: "font-bold uppercase tracking-wider text-zinc-600 hover:text-zinc-900" %>
    <button onclick="window.print()" class="border-2 border-zinc-900 px-4 py-2 font-bold uppercase tracking-wider text-zinc-900 hover:bg-zinc-900 hover:text-white transition cursor-pointer">
      Друк специфікації (PDF)
    </button>
  </div>
</div>