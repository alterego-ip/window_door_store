<div class="flex flex-col lg:flex-row gap-8 items-start">
  <!-- Бокова панель параметрів та фільтрів -->
  <aside class="w-full lg:w-72 bg-white border-2 border-zinc-200 p-5 shrink-0">
    <div class="border-b border-zinc-200 pb-3 mb-4">
      <h3 class="text-xs font-black uppercase tracking-widest text-zinc-900">Номенклатурний фільтр</h3>
    </div>

    <%= form_with url: products_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :query, "Пошук по назві", class: "block text-[11px] font-bold uppercase tracking-wider text-zinc-600 mb-1" %>
        <%= f.text_field :query, value: params[:query], placeholder: "Введіть маркування...", class: "w-full border border-zinc-300 focus:border-zinc-900 px-3 py-1.5 text-xs text-zinc-900 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :category_id, "Категорія", class: "block text-[11px] font-bold uppercase tracking-wider text-zinc-600 mb-1" %>
        <%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), { include_blank: "Всі категорії" }, class: "w-full border border-zinc-300 focus:border-zinc-900 px-2 py-1.5 text-xs bg-white focus:outline-none" %>
      </div>

      <div>
        <label class="block text-[11px] font-bold uppercase tracking-wider text-zinc-600 mb-1">Діапазон цін (грн)</label>
        <div class="grid grid-cols-2 gap-2">
          <%= f.number_field :min_price, value: params[:min_price], placeholder: "Від", class: "w-full border border-zinc-300 px-2 py-1.5 text-xs font-mono-num" %>
          <%= f.number_field :max_price, value: params[:max_price], placeholder: "До", class: "w-full border border-zinc-300 px-2 py-1.5 text-xs font-mono-num" %>
        </div>
      </div>

      <div class="pt-2 flex flex-col gap-2">
        <%= f.submit "Застосувати фільтр", class: "w-full bg-zinc-900 hover:bg-zinc-800 text-white text-[11px] font-bold uppercase tracking-wider py-2.5 transition cursor-pointer" %>
        <%= link_to "Скинути фільтр", products_path, class: "text-center text-[11px] text-zinc-500 hover:text-zinc-900 underline" %>
      </div>
    <% end %>
  </aside>

  <!-- Сітка позицій каталогу -->
  <div class="flex-1 w-full">
    <div class="flex justify-between items-center mb-6 pb-2 border-b border-zinc-200">
      <h1 class="text-xl font-black uppercase tracking-tight text-zinc-900">Готові вироби та комплектуючі</h1>
      <span class="text-xs text-zinc-500 font-mono-num">Знайдено: <%= @products.count %> од.</span>
    </div>

    <% if @products.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
        <% @products.each do |product| %>
          <div class="bg-white border-2 border-zinc-200 hover:border-zinc-900 transition flex flex-col justify-between">
            <div>
              <div class="h-44 bg-zinc-100 border-b border-zinc-200 flex items-center justify-center p-4">
                <% if product.image.attached? %>
                  <%= image_tag product.image, class: "w-full h-full object-contain" %>
                <% else %>
                  <div class="text-center text-zinc-400">
                    <span class="text-[11px] font-mono-num tracking-wider">[ ЗОБРАЖЕННЯ ВІДСУТНЄ ]</span>
                  </div>
                <% end %>
              </div>

              <div class="p-4">
                <div class="flex justify-between items-start gap-2 mb-1">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-amber-700 bg-amber-50 border border-amber-200 px-1.5 py-0.5"><%= product.category.name %></span>
                  <span class="text-[11px] font-mono-num text-zinc-400">SKU: <%= product.sku %></span>
                </div>
                <h3 class="font-bold text-zinc-900 text-sm mt-2 leading-snug"><%= product.name %></h3>
                <p class="text-xs text-zinc-500 mt-2 line-clamp-2"><%= product.description %></p>
              </div>
            </div>

            <div class="p-4 pt-0 border-t border-zinc-100 mt-4">
              <div class="flex items-baseline justify-between pt-3">
                <span class="text-lg font-black font-mono-num text-zinc-900">
                  <%= number_to_currency(product.price, unit: "грн", format: "%n %u") %>
                </span>
                <span class="text-[11px] font-mono-num <%= product.stock > 0 ? 'text-emerald-700' : 'text-rose-600' %>">
                  <%= product.stock > 0 ? "Склад: #{product.stock} шт." : "Під замовлення" %>
                </span>
              </div>

              <!-- Блок дій: деталі та додавання в кошик -->
              <div class="grid grid-cols-2 gap-2 mt-3">
                <%= link_to "Детальніше", product_path(product), class: "block text-center border border-zinc-300 hover:border-zinc-900 text-zinc-800 text-xs font-bold uppercase tracking-wider py-2 transition" %>
                
                <%= button_to "В кошик", cart_items_path(product_id: product.id), method: :post, class: "w-full bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-bold uppercase tracking-wider py-2 transition cursor-pointer text-center" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white border-2 border-zinc-200 p-8 text-center text-zinc-500 text-sm">
        За вашим запитом номенклатури не знайдено.
      </div>
    <% end %>
  </div>
</div>