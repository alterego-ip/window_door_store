<div class="container mx-auto px-4 py-8">
  <div class="flex flex-col md:flex-row gap-8">
    <!-- Бокова панель фільтрів -->
    <aside class="w-full md:w-1/4 bg-white p-6 rounded-xl border border-gray-200 shadow-sm h-fit">
      <h3 class="text-lg font-bold text-gray-800 mb-4">Фільтр товарів</h3>
      <%= form_with url: products_path, method: :get, local: true, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :query, "Пошук", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :query, value: params[:query], placeholder: "Назва товару...", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :category_id, "Категорія", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), { include_blank: "Усі категорії" }, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Ціна (грн)</label>
          <div class="grid grid-cols-2 gap-2">
            <%= f.number_field :min_price, value: params[:min_price], placeholder: "Від", class: "w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm" %>
            <%= f.number_field :max_price, value: params[:max_price], placeholder: "До", class: "w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm" %>
          </div>
        </div>

        <div class="pt-2">
          <%= f.submit "Застосувати", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 rounded-lg text-sm transition cursor-pointer" %>
          <%= link_to "Скинути", products_path, class: "block text-center text-xs text-gray-500 hover:underline mt-2" %>
        </div>
      <% end %>
    </aside>

    <!-- Список товарів -->
    <main class="w-full md:w-3/4">
      <h1 class="text-2xl font-bold text-gray-800 mb-6">Каталог вікон та дверей</h1>

      <% if @products.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @products.each do |product| %>
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
              <div>
                <% if product.image.attached? %>
                  <%= image_tag product.image, class: "w-full h-48 object-cover" %>
                <% else %>
                  <div class="w-full h-48 bg-gray-100 flex items-center justify-center text-gray-400">
                    <span>Немає фото</span>
                  </div>
                <% end %>
                <div class="p-4">
                  <span class="text-xs font-semibold text-blue-600 uppercase tracking-wide"><%= product.category.name %></span>
                  <h2 class="text-lg font-bold text-gray-900 mt-1"><%= product.name %></h2>
                  <p class="text-sm text-gray-500 mt-1">Артикул: <%= product.sku %></p>
                </div>
              </div>

              <div class="p-4 pt-0">
                <div class="flex items-center justify-between mt-4">
                  <span class="text-xl font-extrabold text-gray-900"><%= number_to_currency(product.price, unit: "грн", format: "%n %u") %></span>
                  <span class="text-xs px-2 py-1 rounded <%= product.stock > 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                    <%= product.stock > 0 ? "В наявності (#{product.stock})" : "Під замовлення" %>
                  </span>
                </div>
                <%= link_to "Детальніше", product_path(product), class: "mt-4 block text-center w-full bg-gray-900 hover:bg-gray-800 text-white font-medium py-2 rounded-lg text-sm transition" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-8 text-center text-gray-500">
          Товарів за вказаними фільтрами не знайдено.
        </div>
      <% end %>
    </main>
  </div>
</div>